# Copy these names into Vercel > Settings > Environment Variables, then redeploy.
# Everything here is public (NEXT_PUBLIC_*). Never put private keys in this file.

# ── Before launch ───────────────────────────────────────────

# Your site address once it's on a domain.
NEXT_PUBLIC_APP_URL=https://www.your-domain.com

# Ethereum mainnet RPC for reads. Use an Alchemy/Infura key locked to your domain (it is visible in the browser).
NEXT_PUBLIC_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key

# Phone wallets and QR code. Project ID from dashboard.reown.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# X account. The X icon and links appear once these are set.
NEXT_PUBLIC_X_URL=https://x.com/your_handle
NEXT_PUBLIC_X_HANDLE=@your_handle

# ── At launch (from the finalized Programmable launch record) ─

# Leave the ticker empty until you're ready to show it. The site says "Continuum" until then.
NEXT_PUBLIC_TOKEN_TICKER=
NEXT_PUBLIC_CONTINUUM_TOKEN_ADDRESS=
NEXT_PUBLIC_CONTINUUM_HOOK_ADDRESS=
# Your coin's page on programmable.market.
NEXT_PUBLIC_PROGRAMMABLE_COIN_URL=

# Pool settings from the launch record. Defaults match Programmable's protected launch.
NEXT_PUBLIC_POOL_FEE=0
NEXT_PUBLIC_POOL_TICK_SPACING=60
NEXT_PUBLIC_PROTECTION_SECONDS=300
NEXT_PUBLIC_TOKEN_SUPPLY=1000000000
# Creator fee on trades, in percent, as approved for the launch.
NEXT_PUBLIC_CREATOR_FEE=2.7

# ── After the vault is deployed ─────────────────────────────

# Vault actions on /vaults turn on once both the token and vault addresses are set.
NEXT_PUBLIC_CONTINUUM_VAULT_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
