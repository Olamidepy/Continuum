# ─────────────────────────────────────────────────────────────
#  Wronskian website: Vercel > Settings > Environment Variables
#  Copy each NAME=value line, paste your value, then Redeploy.
#  Everything here is PUBLIC (visible in the browser).
#  Never put a private key here.
# ─────────────────────────────────────────────────────────────


# ═══ 1. ADD NOW ══════════════════════════════════════════════

# Alchemy > Create app > Ethereum Mainnet > copy the HTTPS URL.
# In the app's security settings, restrict it to your domain.
NEXT_PUBLIC_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/PASTE_YOUR_ALCHEMY_KEY

# dashboard.reown.com > Create project > copy the Project ID.
# Add your domain to the project's allowed domains.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=PASTE_YOUR_REOWN_PROJECT_ID

# Your domain, e.g. https://www.wronskian.xyz
NEXT_PUBLIC_APP_URL=


# ═══ 2. ADD ON LAUNCH DAY (printed by launch/script/Launch.s.sol) ═

# Leave empty until launch so scammers can't copy them. Trading turns on once token and hook are set.
NEXT_PUBLIC_WRON_TOKEN_ADDRESS=
NEXT_PUBLIC_WRON_HOOK_ADDRESS=
NEXT_PUBLIC_WRON_FEE_VAULT_ADDRESS=


# ═══ 3. ADD AFTER THE VAULT IS DEPLOYED ═══════════════════════

# The Vaults page turns on once the token and vault addresses are both set.
NEXT_PUBLIC_WRON_VAULT_ADDRESS=
