# ─────────────────────────────────────────────────────────────
#  Continuum website: Vercel > Settings > Environment Variables
#  Copy each NAME=value line, paste your value, then Redeploy.
#  Everything here is PUBLIC (visible in the browser).
#  Never put a private key or the Programmable API key here.
# ─────────────────────────────────────────────────────────────


# ═══ 1. ADD NOW ══════════════════════════════════════════════

# Alchemy > Create app > Ethereum Mainnet > copy the HTTPS URL.
# In the app's security settings, restrict it to continuumxyz.live.
NEXT_PUBLIC_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/PASTE_YOUR_ALCHEMY_KEY

# dashboard.reown.com > Create project > copy the Project ID.
# Add continuumxyz.live to the project's allowed domains.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=PASTE_YOUR_REOWN_PROJECT_ID


# ═══ 2. ALREADY SET IN THE CODE (only add to override) ═══════

# NEXT_PUBLIC_APP_URL=https://www.continuumxyz.live
# NEXT_PUBLIC_X_URL=https://x.com/continuum_xyz
# NEXT_PUBLIC_X_HANDLE=@continuum_xyz
# NEXT_PUBLIC_TOKEN_SUPPLY=1000000000
# NEXT_PUBLIC_CREATOR_FEE=2.7
# NEXT_PUBLIC_INITIAL_BUY_USD=4
# NEXT_PUBLIC_POOL_FEE=0
# NEXT_PUBLIC_POOL_TICK_SPACING=60


# ═══ 3. ADD ON LAUNCH DAY (from the finalized Programmable launch) ═

# Leave empty until launch so scammers can't copy it. The site shows "Continuum" until then.
NEXT_PUBLIC_TOKEN_TICKER=
NEXT_PUBLIC_CONTINUUM_TOKEN_ADDRESS=
NEXT_PUBLIC_CONTINUUM_HOOK_ADDRESS=
# Your coin's page on programmable.market.
NEXT_PUBLIC_PROGRAMMABLE_COIN_URL=


# ═══ 4. ADD AFTER THE VAULT IS DEPLOYED ═══════════════════════

# The Vaults page turns on once the token and vault addresses are both set.
NEXT_PUBLIC_CONTINUUM_VAULT_ADDRESS=
