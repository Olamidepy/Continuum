# ─────────────────────────────────────────────────────────────
#  Vault deploy settings. PRIVATE.
#  Copy this file to contracts/.env on your own computer and fill it in.
#  Never commit .env, never add it to Vercel, never paste it in chat.
# ─────────────────────────────────────────────────────────────

# A FRESH wallet used only to deploy the vault. Fund it with a little ETH for gas (not the dev wallet).
DEPLOYER_PRIVATE_KEY=PASTE_FRESH_DEPLOYER_PRIVATE_KEY

# Alchemy Ethereum Mainnet URL. Use a SECOND app with no domain restriction (the site's key won't work here).
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/PASTE_UNRESTRICTED_KEY

# Optional: an Alchemy Sepolia URL, to test-deploy first.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/PASTE_KEY

# The token address from your finalized Programmable launch. Fixed in the vault forever.
CONTINUUM_TOKEN_ADDRESS=

# etherscan.io > API Keys. Verifies the vault's source code after deploy.
ETHERSCAN_API_KEY=PASTE_ETHERSCAN_KEY


# ─── Programmable launch submission (only on the machine that submits) ───
# programmable.market/developers/api-keys, created with the dev wallet
# 0x64b646C9B4ec3C03f16A47e3F4e838615EeBddD7, for Ethereum Mainnet,
# scopes custom-launch:create + custom-launch:read.
PROGRAMMABLE_API_KEY=PASTE_PROGRAMMABLE_API_KEY
