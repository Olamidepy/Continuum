# Contract deploy settings. Never commit the real .env.

# Wallet that pays gas for the vault deploy. Use a fresh wallet with only enough ETH for gas.
DEPLOYER_PRIVATE_KEY=

# Ethereum RPC links (Alchemy, Infura, etc.). Server-side only.
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=

# Token address from your finalized Programmable launch.
CONTINUUM_TOKEN_ADDRESS=
# Receives 20% of every early-exit penalty. Fixed forever at deploy.
TREASURY_ADDRESS=

# Optional: verifies the source on Etherscan after deploy.
ETHERSCAN_API_KEY=
